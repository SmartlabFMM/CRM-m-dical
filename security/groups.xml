<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_smartlab" model="ir.module.category">
        <field name="name">SmartLab</field>
        <field name="sequence">30</field>
    </record>

    <record id="privilege_smartlab_access" model="res.groups.privilege">
        <field name="name">SmartLab Access</field>
        <field name="category_id" ref="module_category_smartlab"/>
    </record>

    <!-- Groupe de base : accès minimal (menus communs) -->
    <record id="group_smartlab_user" model="res.groups">
        <field name="name">SmartLab User</field>
        <field name="privilege_id" ref="privilege_smartlab_access"/>
    </record>

    <!-- Médecin : hérite de User -->
 <record id="group_smartlab_doctor" model="res.groups">
    <field name="name">Medecin SmartLab</field>
    <field name="privilege_id" ref="privilege_smartlab_access"/>
    <field name="implied_ids" eval="[Command.set([ref('group_smartlab_user')])]"/>
</record>

<record id="group_smartlab_secretary" model="res.groups">
    <field name="name">Secretaire SmartLab</field>
    <field name="privilege_id" ref="privilege_smartlab_access"/>
    <field name="implied_ids" eval="[Command.set([ref('group_smartlab_user')])]"/>
</record>

<record id="group_smartlab_admin" model="res.groups">
    <field name="name">Administrateur SmartLab</field>
    <field name="privilege_id" ref="privilege_smartlab_access"/>
    <field name="implied_ids" eval="[Command.set([ref('group_smartlab_secretary')])]"/>
</record>
</odoo>