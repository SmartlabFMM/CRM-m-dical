<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_medical_patient_form" model="ir.ui.view">
        <field name="name">medical.patient.form</field>
        <field name="model">medical.patient</field>
        <field name="arch" type="xml">
            <form string="Patient">
                <header>
                    <button name="action_nouveau_rendezvous"
                            string="Nouveau Rendez-vous"
                            type="object"
                            class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="reference"/>
                        <h2><field name="reference" readonly="1"/></h2>
                        <h1><field name="name" placeholder="Nom complet du patient"/></h1>
                    </div>

                    <group string="Informations Personnelles">
                        <group>
                            <field name="cin"/>
                            <field name="gender"/>
                            <field name="birthdate"/>
                            <field name="age" readonly="1"/>
                        </group>
                        <group>
                            <field name="blood_type"/>
                            <field name="phone"/>
                            <field name="email" widget="email"/>
                        </group>
                    </group>
                        <group>
                            <field name="state"/>
                        </group>
                    <group string="Adresse">
                        <field name="address" nolabel="1" placeholder="Adresse complète"/>
                    </group>

                    <notebook>
                        <page string="Informations Médicales" name="medical">
                            <group>
                                <field name="allergies" placeholder="Allergies connues..."/>
                                <field name="chronic_diseases" placeholder="Maladies chroniques..."/>
                            </group>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes" placeholder="Notes médicales supplémentaires..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>


    <record id="view_medical_patient_list" model="ir.ui.view">
        <field name="name">medical.patient.list</field>
        <field name="model">medical.patient</field>
        <field name="arch" type="xml">
            <list string="Patients">
                <field name="reference"/>
                <field name="name"/>
                <field name="cin"/>
                <field name="gender"/>
                <field name="age"/>
                <field name="phone"/>
                <field name="blood_type"/>
                <field name="state" decoration-success="state == 'active'"
                       decoration-muted="state == 'inactive'"/>
            </list>
        </field>
    </record>


    <record id="view_medical_patient_search" model="ir.ui.view">
        <field name="name">medical.patient.search</field>
        <field name="model">medical.patient</field>
        <field name="arch" type="xml">
            <search string="Rechercher un patient">
                <field name="name" string="Nom" filter_domain="[('name','ilike',self)]"/>
                <field name="cin" string="CIN"/>
                <field name="phone" string="Téléphone"/>
                <separator/>
                <filter string="Actifs" name="active_patients" domain="[('state','=','active')]"/>
                <filter string="Inactifs" name="inactive_patients" domain="[('state','=','inactive')]"/>
                <separator/>
                <filter string="Masculin" name="male" domain="[('gender','=','male')]"/>
                <filter string="Féminin" name="female" domain="[('gender','=','female')]"/>
                <separator/>
                <filter string="Par Sexe" name="group_gender" context="{'group_by': 'gender'}"/>
                <filter string="Par Groupe sanguin" name="group_blood" context="{'group_by': 'blood_type'}"/>
                <filter string="Par Statut" name="group_state" context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <record id="view_medical_patient_kanban" model="ir.ui.view">
        <field name="name">medical.patient.kanban</field>
        <field name="model">medical.patient</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state">
                <field name="name"/>
                <field name="reference"/>
                <field name="cin"/>
                <field name="phone"/>
                <field name="gender"/>
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <div class="fw-bold fs-5">
                            <field name="name"/>
                        </div>
                        <div class="text-muted small">
                            <span><i class="fa fa-id-card me-1"/><field name="reference"/></span>
                        </div>
                        <div class="mt-1">
                            <span><i class="fa fa-phone me-1"/><field name="phone"/></span>
                        </div>
                        <div class="mt-1">
                            <span><i class="fa fa-id-badge me-1"/><field name="cin"/></span>
                        </div>
                        <footer>
                           
                            <field name="state" widget="badge"
                                   decoration-success="state == 'active'"
                                   decoration-secondary="state == 'inactive'"/>
                            <field name="gender" widget="badge" class="ms-1"/>
                        </footer>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_medical_patient" model="ir.actions.act_window">
        <field name="name">Patients</field>
        <field name="res_model">medical.patient</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="view_medical_patient_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Créer votre premier patient
            </p>
        </field>
    </record>
# SÉQUENCE
    <record id="seq_medical_patient" model="ir.sequence">
        <field name="name">Séquence Patient</field>
        <field name="code">medical.patient</field>
        <field name="prefix">PAT</field>
        <field name="padding">5</field>
        <field name="number_next">1</field>
        <field name="number_increment">1</field>
    </record>

</odoo>