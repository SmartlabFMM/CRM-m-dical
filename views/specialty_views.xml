<?xml version="1.0" encoding="utf-8"?>
<odoo>


    <record id="view_medical_specialty_form" model="ir.ui.view">
        <field name="name">medical.specialty.form</field>
        <field name="model">medical.specialty</field>
        <field name="arch" type="xml">
            <form string="Spécialité">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Nom de la spécialité"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="doctor_count" string="Médecins"/>
                        </group>
                    </group>
                    <field name="description" placeholder="Description..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_medical_specialty_list" model="ir.ui.view">
        <field name="name">medical.specialty.list</field>
        <field name="model">medical.specialty</field>
        <field name="arch" type="xml">
            <list string="Spécialités">
                <field name="code"/>
                <field name="name"/>
                <field name="doctor_count" string="Médecins"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="action_medical_specialty" model="ir.actions.act_window">
        <field name="name">Spécialités</field>
        <field name="res_model">medical.specialty</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>