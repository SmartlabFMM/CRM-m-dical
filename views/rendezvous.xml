<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_medical_rendezvous_form" model="ir.ui.view">
        <field name="name">medical.rendezvous.form</field>
        <field name="model">medical.rendezvous</field>
        <field name="arch" type="xml">
            <form string="Rendez-vous">
                <header>
                    <button name="action_creer_consultation"
                            string="Créer Consultation"
                            type="object"
                            class="btn-primary"
                            invisible="etat != 'confirme'"
                            groups="smartlab.group_smartlab_doctor"/>
                    <button name="terminer" string="Terminer" type="object"
                            class="btn-secondary"
                            invisible="etat != 'confirme'"
                            groups="smartlab.group_smartlab_secretary,smartlab.group_smartlab_admin"/>
                    <button name="annuler" string="Annuler" type="object"
                            invisible="etat != 'confirme'"
                            groups="smartlab.group_smartlab_secretary,smartlab.group_smartlab_admin"/>

                    <button name="confirmer" string=" Rétablir Confirmé" type="object"
                            class="btn-secondary"
                            invisible="etat not in ['annule', 'termine']"
                            groups="smartlab.group_smartlab_secretary,smartlab.group_smartlab_admin"/>

                    <field name="etat" widget="statusbar"
                           statusbar_visible="confirme,termine,annule"/>
                </header>
                <sheet>
                    <group>
                        <group string="Informations">
                            <field name="reference" readonly="1"/>
                            <field name="patient_id"/>
                            <field name="medecin_id"/>
                            <field name="salle_id"/>
                        </group>
                        <group string="Dates">
                            <field name="date_debut"/>
                            <field name="date_fin"/>
                        </group>
                    </group>
                    <group string="Motif">
                        <field name="motif" nolabel="1"/>
                    </group>

                    <group string="Triage Intelligent ">
                        <field name="priorite_score"
                               widget="badge"
                               decoration-danger="priorite_score== 'urgent'"
                               decoration-warning="priorite_score== 'prioritaire'"
                               decoration-success="priorite_score== 'normal'"/>
                    </group>

<notebook>
    <page string="Consultations" name="consultations">
        <field name="consultation_ids" readonly="1">
            <list>
                <field name="date"/>
                <field name="diagnostic"/>
                <field name="tarif_consultation"/>
                <field name="etat" widget="badge"/>
            </list>
        </field>
    </page>
</notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_medical_rendezvous_list" model="ir.ui.view">
        <field name="name">medical.rendezvous.list</field>
        <field name="model">medical.rendezvous</field>
        <field name="arch" type="xml">
            <list string="Rendez-vous"
                  decoration-success="etat == 'termine'"
                  decoration-warning="etat == 'confirme'"
                  decoration-danger="etat == 'annule'">
                <field name="reference"/>
                <field name="patient_id"/>
                <field name="medecin_id"/>
                <field name="date_debut"/>
                <field name="date_fin"/>
                <field name="etat" widget="badge"
                       decoration-success="etat == 'termine'"
                       decoration-warning="etat == 'confirme'"
                       decoration-danger="etat == 'annule'"/>
                <field name="priorite_score" widget="badge"
                       decoration-danger="priorite_score== 'urgent'"
                       decoration-warning="priorite_score== 'prioritaire'"
                       decoration-success="priorite_score== 'normal'"/>
            </list>
        </field>
    </record>

    <record id="view_medical_rendezvous_calendar" model="ir.ui.view">
        <field name="name">medical.rendezvous.calendar</field>
        <field name="model">medical.rendezvous</field>
        <field name="arch" type="xml">
            <calendar string="Calendrier Rendez-vous"
                      date_start="date_debut" color="medecin_id">
                <field name="patient_id"/>
                <field name="medecin_id"/>
            </calendar>
        </field>
    </record>

    <record id="view_medical_rendezvous_search" model="ir.ui.view">
        <field name="name">medical.rendezvous.search</field>
        <field name="model">medical.rendezvous</field>
        <field name="arch" type="xml">
            <search string="Rechercher un rendez-vous">
                <field name="reference"/>
                <field name="patient_id"/>
                <field name="medecin_id"/>
                <filter string="Confirmés"  name="confirme"
                        domain="[('etat','=','confirme')]"/>
                <filter string="Terminés"   name="termine"
                        domain="[('etat','=','termine')]"/>
                <filter string="Annulés"    name="annule"
                        domain="[('etat','=','annule')]"/>
                <separator/>
                <filter string="🔴 Urgent"      name="urgent"
                        domain="[('priorite_score','=','urgent')]"/>
                <filter string="🟡 Prioritaire" name="prioritaire"
                        domain="[('priorite_score','=','prioritaire')]"/>
                <filter string="🟢 Normal"      name="normal"
                        domain="[('priorite_score','=','normal')]"/>
                <separator/>
                <filter name="par_medecin" string="Médecin"
                        context="{'group_by': 'medecin_id'}"/>
                <filter name="par_patient" string="Patient"
                        context="{'group_by': 'patient_id'}"/>
                <filter name="par_priorite" string="Priorité score"
                        context="{'group_by': 'priorite_score'}"/>
            </search>
        </field>
    </record>

    <record id="action_medical_rendezvous" model="ir.actions.act_window">
        <field name="name">Rendez-vous</field>
        <field name="res_model">medical.rendezvous</field>
        <field name="view_mode">list,form,calendar</field>
        <field name="search_view_id" ref="view_medical_rendezvous_search"/>
    </record>

</odoo>